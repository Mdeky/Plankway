{
  "name": "bridgle",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "bench": "pnpm --filter @bridgle/core bench",
    "dev:web": "pnpm --filter @bridgle/web dev",
    "dev:api": "pnpm --filter @bridgle/api dev",
    "db:setup:local": "pnpm --filter @bridgle/api db:migrate:local && node scripts/generate-daily.ts --apply local",
    "daily:generate": "node scripts/generate-daily.ts",
    "build:web": "pnpm --filter @bridgle/web build",
    "check:bundle": "pnpm build:web && node scripts/check-bundle.ts",
    "icons": "node scripts/make-icons.ts",
    "check:launch": "node scripts/check-launch.ts",
    "deploy": "pnpm --filter @bridgle/api deploy"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
